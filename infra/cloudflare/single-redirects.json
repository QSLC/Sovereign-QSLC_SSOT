{
  "schema": "qslc.cloudflare.single-redirects.v1",
  "zone": "qslc-hei.com",
  "phase": "http_request_dynamic_redirect",
  "rules": [
    {
      "ref": "qslc_www_to_apex_2026_11",
      "description": "Canonicalize www.qslc-hei.com to the owner-controlled apex domain while preserving path and query string.",
      "expression": "http.host eq \"www.qslc-hei.com\"",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "target_url": {
            "expression": "concat(\"https://qslc-hei.com\", http.request.uri.path)"
          },
          "status_code": 301,
          "preserve_query_string": true
        }
      },
      "enabled": true
    }
  ]
}
