{
  "name": "qslc-eve-command-center",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint .",
    "preview": "vite preview",
    "public:test": "node scripts/public-contracts.test.mjs",
    "governance:test": "node --experimental-strip-types scripts/governance-contracts.test.mjs",
    "contract:test": "node scripts/public-contract-validator.test.mjs",
    "contract:validate": "node scripts/validate-public-contract.mjs public/public-metrics.json",
    "deploy:test": "node scripts/check-deployment.test.mjs",
    "deploy:check": "node scripts/check-deployment.mjs",
    "privacy:test": "node scripts/privacy-scan.test.mjs",
    "privacy:scan": "node scripts/privacy-scan.mjs .",
    "privacy:scan:dist": "node scripts/privacy-scan.mjs dist"
  },
  "dependencies": {
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  }
}
